# systemd-enhet för Tornstridens onlineserver (arbetsordning L21–L22). Mall: drift/installera.sh fyller i sökvägar,
# användare och node-sökväg och lägger den i /etc/systemd/system/tornstriden-online.service.
# Tjänsten körs som den egna systemanvändaren `tornstriden` (ingen inloggning, inget hem i /home) från sin egen
# Git-utcheckning i /opt/tornstriden – den importerar spelmotorn och kontrakt.js därifrån. Databasen ligger i
# /var/lib/tornstriden, utanför webbrot och Git.
[Unit]
Description=Tornstriden onlineserver (lobby och matcher)
Documentation=file:///opt/tornstriden/DRIFT.md
After=network.target
# Apache behöver inte tjänsten för att starta; proxyn svarar 503 tills tjänsten är uppe.

[Service]
Type=simple
User=tornstriden
Group=tornstriden
WorkingDirectory=/opt/tornstriden
EnvironmentFile=/etc/tornstriden-online.env
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning online/server.js
# SIGUSR1 = underhållsläge (inga nya matcher), SIGUSR2 = öppna igen. Se drift/uppdatera.sh.
# Vid stopp får tjänsten SIGTERM och stänger strömmarna; pågående matcher avbryts utan vinnare vid nästa start (27B).
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=on-failure
RestartSec=3
# Om tjänsten inte kan starta (t.ex. porten upptagen eller lagringsfel vid uppstädningen) avslutar den med kod 1
# och systemd försöker igen; journalctl -u tornstriden-online visar orsaken.

# Härdning: bara datakatalogen är skrivbar, inget annat i filsystemet; /home är helt dolt.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/tornstriden
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
# (node behöver JIT; därför inte MemoryDenyWriteExecute=yes)

[Install]
WantedBy=multi-user.target
