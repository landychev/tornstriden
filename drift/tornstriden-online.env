# Miljö för tornstriden-online (läses av systemd-enheten). Mall: drift/installera.sh fyller i värdena och lägger den
# i /etc/tornstriden-online.env. Inga hemligheter behövs: sessionstoken slumpas per session och lagras hashad.
PORT=8766
HOST=127.0.0.1
# Apache serverar sidorna; tjänsten svarar bara på /api/.
TORNSTRIDEN_STATIC=0
# Bakom HTTPS: Secure på sessionskakan och bara spelets ursprung får skicka kommandon.
TORNSTRIDEN_SECURE=1
TORNSTRIDEN_ORIGINS=https://tornstriden.landychev.se
# Nya sessioner per klientadress och minut. Befintliga sessioner och livstecken räknas inte.
TORNSTRIDEN_REGISTRERINGAR_PER_MINUT=20
# Databasen (SQLite, WAL-läge) – utanför webbrot och Git, i tjänsteanvändarens egen katalog (skapas av installera.sh).
TORNSTRIDEN_DATA_DIR=/var/lib/tornstriden
# TORNSTRIDEN_LAGSPEL=0 skulle stänga lagformaten 4/6/8 i lobbyn (bara duell).
