# Miljö för tornstriden-online (läses av systemd-enheten). Kopieras till /etc/tornstriden-online.env.
# Inga hemligheter behövs: sessionstoken slumpas per session och lagras hashad i databasen.
PORT=8766
HOST=127.0.0.1
# Apache serverar sidorna; tjänsten svarar bara på /api/.
TORNSTRIDEN_STATIC=0
# Bakom HTTPS: Secure på sessionskakan och bara spelets ursprung får skicka kommandon.
TORNSTRIDEN_SECURE=1
TORNSTRIDEN_ORIGINS=https://tornstriden.landychev.se
# Databasen (SQLite, WAL-läge) – utanför webbrot och Git, samma plats som `npm run online` använder (../tornstriden-data).
# Katalogen måste finnas innan tjänsten startar (systemd gör resten av /home skrivskyddat): se DRIFT.md.
TORNSTRIDEN_DATA_DIR=/home/landy/github-proj/tornstriden-data
# TORNSTRIDEN_LAGSPEL=0 skulle stänga lagformaten 4/6/8 i lobbyn (bara duell).
